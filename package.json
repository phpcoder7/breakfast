{
  "name": "breakfast-checkin",
  "version": "1.0.0",
  "description": "High-performance digital breakfast check-in system for hotel operations",
  "type": "module",
  "scripts": {
    "build": "esbuild js/app.js --bundle --format=iife --loader:.txt=text --minify --sourcemap --outfile=js/app.bundle.js",
    "build:dev": "esbuild js/app.js --bundle --format=iife --loader:.txt=text --sourcemap --outfile=js/app.bundle.js",
    "test": "node tests/run-tests.js",
    "test:bundle": "esbuild tests/run-tests.js --bundle --platform=node --loader:.txt=text --outfile=tests/bundle-test.cjs && node tests/bundle-test.cjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
